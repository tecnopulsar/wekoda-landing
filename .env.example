# Sitio público (marketing). Sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.wekoda.lat

# Panel admin del monorepo iot-over-ip (full). Sin barra final.
# Dejarlo vacío: el host de la página elige el destino.
# Lab (localhost, IP LAN o puerto 3010) → http://<ese host>:3001/settings/login
# cms.wekoda.lat, www.wekoda.lat y wekoda.lat → https://cms.wekoda.lat/settings/login
# Definilo solo para forzar un único destino en todos los hosts.
# NEXT_PUBLIC_APP_ORIGIN=

# Formulario de contacto (Resend) — ver docs internos
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# EMAIL_DESTINATARIO=
